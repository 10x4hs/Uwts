{
  "manifest_version": 3,
  "name": "Uwts Lyrics",
  "version": "0.1.10",
  "description": "Synced lyrics side panel for YouTube music videos.",
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://i.ytimg.com/*",
    "https://music.163.com/*",
    "https://www.youtube.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "netease",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "optional_host_permissions": [
    "https://*.bugs.co.kr/*",
    "https://*.genie.co.kr/*",
    "https://*.melon.com/*"
  ],
  "options_ui": {
    "page": "grant.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
